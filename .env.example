# 免费 API：不配置时 RDAP/DNS/RIPEstat/crt.sh 仍可使用。
# 银行/企业/其他商业业务默认 business；此模式绝不调用 VirusTotal 免费 Public API。
# 仅明确符合 VirusTotal 非商业许可的个人/学术研究才能设置 noncommercial。
# 官方政策：https://docs.virustotal.com/reference/public-vs-premium-api
# 不要把真实 API Key 提交到 Git 或复制到聊天。
VT_USAGE=business
OTX_API_KEY=
URLSCAN_API_KEY=
VT_API_KEY=
# 国内威胁情报：默认没有任何微步 API 请求，免费 X 网页可手动查询。
# 域名分析 API 不保证包含在个人免费配额；仅实际有免费额度、机构用途授权时才改 yes。
THREATBOOK_API_AUTHORIZED=no
THREATBOOK_API_KEY=
